# Environment Configuration for Mobile Tracker App VPS Deployment

# Application
APP_NAME=food-tracker-app
DOMAIN=yummyrecs.com

# Email for Let's Encrypt (used in Caddyfile)
ADMIN_EMAIL=22228236+nicholaspung@users.noreply.github.com

# PocketBase Configuration
TZ=America/Los_Angeles

# ============================================
# PocketBase Settings Encryption (Security)
# ============================================
# IMPORTANT: These keys encrypt sensitive application settings like:
# - SMTP passwords
# - S3/storage credentials
# - OAuth client secrets
# - API keys stored in PocketBase settings
#
# Generate keys with: bash scripts/generate-encryption-keys.sh
#
# Requirements:
# - Must be exactly 32 characters
# - Use different keys for production and beta
# - Keep these keys SECRET and backed up securely
# - Never commit these keys to git
#
# Key rotation: If compromised, generate new keys and restart containers
# Note: Changing keys will require re-entering encrypted settings in PocketBase admin UI

# Production environment encryption key (32 characters)
ENCRYPTION_KEY_PROD=

# Beta environment encryption key (32 characters)
ENCRYPTION_KEY_BETA=

# Frontend Build Configuration (for local reference)
# VITE_API_URL is set during build time in frontend/.env

# GitHub Actions Secrets (configure in GitHub repo settings)
# These are NOT stored in this file - add them as repository secrets
# VPS_HOST=your.vps.ip.address
# VPS_USER=deploy
# VPS_SSH_KEY=<your-private-ssh-key>
# VPS_PORT=22
