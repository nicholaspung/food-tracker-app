# Environment Configuration for Mobile Tracker App VPS Deployment

# Application
APP_NAME=mobile-tracker-app
DOMAIN=myexperiment.life

# Email for Let's Encrypt (used in Caddyfile)
ADMIN_EMAIL=nicholaspungdev@gmail.com

# PocketBase Configuration
TZ=America/Los_Angeles

# Frontend Build Configuration (for local reference)
# VITE_API_URL is set during build time in frontend/.env

# GitHub Actions Secrets (configure in GitHub repo settings)
# These are NOT stored in this file - add them as repository secrets
# VPS_HOST=your.vps.ip.address
# VPS_USER=deploy
# VPS_SSH_KEY=<your-private-ssh-key>
# VPS_PORT=22
