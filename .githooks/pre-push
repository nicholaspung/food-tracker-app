#!/bin/bash

# Pre-push hook to validate E2E tests before pushing to main branch
# This prevents broken code from being pushed to the repository

set -e

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}🔍 Pre-push validation started...${NC}"

# Get the current branch
current_branch=$(git symbolic-ref --short HEAD)

# Only run checks when pushing to main
if [ "$current_branch" != "main" ]; then
  echo -e "${GREEN}✅ Not pushing to main branch, skipping pre-push checks${NC}"
  exit 0
fi

echo -e "${YELLOW}📋 Pushing to main branch - running validation checks...${NC}"

# Check if frontend directory exists
if [ ! -d "frontend" ]; then
  echo -e "${RED}❌ Frontend directory not found${NC}"
  exit 1
fi

cd frontend

# Check if dependencies are installed
if [ ! -d "node_modules" ]; then
  echo -e "${YELLOW}📦 Installing dependencies...${NC}"
  npm ci
fi

# Run TypeScript type checking
echo -e "${YELLOW}🔍 Running TypeScript type check...${NC}"
if ! npm run build > /dev/null 2>&1; then
  echo -e "${RED}❌ TypeScript type check failed!${NC}"
  echo -e "${RED}Please fix type errors before pushing to main.${NC}"
  exit 1
fi
echo -e "${GREEN}✅ TypeScript type check passed${NC}"

# Run E2E tests
echo -e "${YELLOW}🧪 Running E2E tests...${NC}"
if ! npm run test:e2e > /dev/null 2>&1; then
  echo -e "${RED}❌ E2E tests failed!${NC}"
  echo -e "${RED}Please ensure all tests pass before pushing to main.${NC}"
  echo -e "${YELLOW}💡 Run 'npm run test:e2e:ui' to debug failing tests${NC}"
  exit 1
fi
echo -e "${GREEN}✅ All E2E tests passed${NC}"

cd ..

echo -e "${GREEN}✅ Pre-push validation completed successfully!${NC}"
echo -e "${YELLOW}📝 After push completes, GitHub Actions will:${NC}"
echo -e "${YELLOW}   - Update E2E test documentation${NC}"
echo -e "${YELLOW}   - Update API endpoint documentation${NC}"
echo -e "${YELLOW}   - Update README with new features${NC}"
echo -e "${YELLOW}   - Generate What's New changelog entry${NC}"

exit 0
