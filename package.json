{
  "name": "food-tracker-app",
  "version": "1.0.0",
  "private": true,
  "main": "apps/mobile/index.js",
  "packageManager": "pnpm@10.32.1",
  "description": "Mobile tracker application with React frontend and Go backend",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:app": "EXPO_NO_DOTENV=1 pnpm --filter @food-tracker/mobile start -- --dev-client --web --localhost",
    "dev:app-ios": "EXPO_NO_DOTENV=1 pnpm --filter @food-tracker/mobile start -- --dev-client --ios --web --localhost",
    "dev:admin": "pnpm --filter @food-tracker/admin dev -- --host localhost --port 5173",
    "dev:api": "cd backend && go run . serve",
    "dev:marketing": "node scripts/dev-marketing.mjs",
    "dev:web": "concurrently \"pnpm dev:admin\" \"pnpm dev:api\"",
    "install:admin": "pnpm install --filter @food-tracker/admin...",
    "install:backend": "cd backend && go mod tidy",
    "install:all": "pnpm install && pnpm install:backend",
    "admin:build": "pnpm --filter @food-tracker/admin build",
    "admin:typecheck": "pnpm --filter @food-tracker/admin typecheck",
    "mobile:install": "pnpm install --filter @food-tracker/mobile...",
    "mobile:start": "EXPO_NO_DOTENV=1 pnpm --filter @food-tracker/mobile start -- --port=19000",
    "mobile:start:local": "bash scripts/mobile-expo.sh local --port=19000",
    "mobile:start:beta": "bash scripts/mobile-expo.sh beta --port=19000",
    "mobile:start:production": "bash scripts/mobile-expo.sh production --port=19000",
    "mobile:web:local": "bash scripts/mobile-expo.sh local --web",
    "mobile:web:beta": "bash scripts/mobile-expo.sh beta --web",
    "mobile:web:production": "bash scripts/mobile-expo.sh production --web",
    "mobile:ios": "EXPO_NO_DOTENV=1 pnpm --filter @food-tracker/mobile ios",
    "mobile:android": "EXPO_NO_DOTENV=1 pnpm --filter @food-tracker/mobile android",
    "mobile:web:build": "pnpm --filter @food-tracker/mobile web:build",
    "mobile:update:preview": "pnpm --filter @food-tracker/mobile update:preview",
    "mobile:update:production-preview": "pnpm --filter @food-tracker/mobile update:production-preview",
    "mobile:lint": "pnpm --filter @food-tracker/mobile lint",
    "mobile:unused-exports": "node scripts/check-mobile-unused-exports.mjs",
    "mobile:screenshots": "bash scripts/mobile-screenshot-suite.sh",
    "mobile:screenshots:review": "node scripts/mobile-screenshot-review-server.mjs",
    "mobile:typecheck": "pnpm --filter @food-tracker/mobile typecheck",
    "mobile:test": "pnpm --filter @food-tracker/mobile test",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "browser-sync": "^3.0.3",
    "chokidar": "^4.0.3",
    "concurrently": "^8.2.2",
    "start-server-and-test": "^2.1.2"
  },
  "dependencies": {
    "expo": "~54.0.33",
    "react": "19.1.0",
    "react-native": "0.81.5"
  }
}
