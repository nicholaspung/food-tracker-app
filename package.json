{
  "name": "food-tracker-app",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "main": "apps/mobile/index.js",
  "packageManager": "pnpm@11.1.2",
  "description": "Mobile tracker application with React frontend and Go backend",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:stream": "FOOD_TRACKER_DEV_UI=stream bash scripts/dev.sh",
    "dev:app": "bash scripts/mobile-expo.sh local",
    "dev:app-ios": "bash scripts/mobile-expo.sh local --ios",
    "dev:admin": "pnpm --filter @food-tracker/admin dev",
    "dev:api": "pnpm --filter @food-tracker/api dev",
    "dev:mailpit": "pnpm --filter @food-tracker/mailpit dev",
    "dev:marketing": "pnpm --filter @food-tracker/marketing dev",
    "dev:web": "concurrently \"pnpm dev:admin\" \"pnpm dev:api\"",
    "install:admin": "pnpm install --filter @food-tracker/admin...",
    "install:backend": "cd backend && go mod tidy",
    "install:all": "pnpm install && pnpm install:backend",
    "admin:build": "pnpm --filter @food-tracker/admin build",
    "admin:typecheck": "pnpm --filter @food-tracker/admin typecheck",
    "mobile:install": "pnpm install --filter @food-tracker/mobile...",
    "mobile:start": "EXPO_NO_DOTENV=1 pnpm --filter @food-tracker/mobile start -- --port=19000",
    "mobile:start:local": "bash scripts/mobile-expo.sh local --port=19000",
    "mobile:start:beta": "bash scripts/mobile-expo.sh beta --port=19000",
    "mobile:start:production": "bash scripts/mobile-expo.sh production --port=19000",
    "mobile:web:local": "bash scripts/mobile-expo.sh local --web",
    "mobile:web:beta": "bash scripts/mobile-expo.sh beta --web",
    "mobile:web:production": "bash scripts/mobile-expo.sh production --web",
    "mobile:ios": "EXPO_NO_DOTENV=1 pnpm --filter @food-tracker/mobile ios",
    "mobile:android": "EXPO_NO_DOTENV=1 pnpm --filter @food-tracker/mobile android",
    "mobile:web:build": "pnpm --filter @food-tracker/mobile web:build",
    "mobile:update:preview": "pnpm --filter @food-tracker/mobile update:preview",
    "mobile:update:production-preview": "pnpm --filter @food-tracker/mobile update:production-preview",
    "mobile:update:production": "pnpm --filter @food-tracker/mobile update:production",
    "mobile:build:ios:preview:local": "bash scripts/mobile-eas-build-ios-preview-local.sh",
    "mobile:lint": "pnpm --filter @food-tracker/mobile lint",
    "mobile:doctor": "bash scripts/mobile-doctor.sh",
    "mobile:asset-size": "node scripts/check-mobile-asset-size.mjs",
    "mobile:unused-exports": "node scripts/check-mobile-unused-exports.mjs",
    "mobile:typecheck": "pnpm --filter @food-tracker/mobile typecheck",
    "mobile:test": "pnpm --filter @food-tracker/mobile test",
    "mobile:tutorial:media": "node scripts/generate-mobile-tutorial-media.mjs",
    "mobile:tutorial:ios:record": "bash scripts/tutorials/record-ios-mov.sh",
    "tools:dev": "concurrently \"pnpm tools:pb\" \"pnpm tools:server\" \"pnpm tools:web\"",
    "tools:web": "pnpm --filter @food-tracker/tools dev --host localhost --port 5174",
    "tools:server": "node tools/frontend/server.mjs",
    "tools:pb": "cd tools/backend && go run . serve --http=127.0.0.1:8092 --dir=../pb_data",
    "tools:build": "pnpm --filter @food-tracker/tools build",
    "tools:typecheck": "pnpm --filter @food-tracker/tools typecheck",
    "mobile:verify-native-entrypoint": "node scripts/verify-mobile-native-entrypoint.mjs",
    "android": "pnpm mobile:android",
    "ios": "pnpm mobile:ios"
  },
  "devDependencies": {
    "browser-sync": "3.0.4",
    "chokidar": "^4.0.3",
    "concurrently": "^8.2.2",
    "start-server-and-test": "3.0.2",
    "turbo": "^2.9.10"
  },
  "dependencies": {
    "expo": "55.0.24",
    "react": "19.2.0",
    "react-native": "0.83.6"
  },
  "pnpm": {
    "overrides": {
      "@expo/plist": "0.5.2",
      "@tootallnate/once": "3.0.1",
      "@xmldom/xmldom": "0.8.13",
      "axios": "1.15.2",
      "diff": "8.0.3",
      "eas-cli>ajv": "8.18.0",
      "eas-cli>minimatch": "5.1.8",
      "flatted": "3.4.2",
      "follow-redirects": "1.16.0",
      "expo-image-loader": "55.0.1",
      "lodash": "4.18.0",
      "node-forge": "1.4.0",
      "picomatch": "4.0.4",
      "postcss": "8.5.10",
      "socket.io-parser": "4.2.6",
      "tar": "7.5.11",
      "yaml": "2.8.3"
    },
    "patchedDependencies": {
      "expo-sqlite@55.0.16": "patches/expo-sqlite@55.0.16.patch"
    },
    "packageExtensions": {
      "@react-native-community/datetimepicker@8.6.0": {
        "dependencies": {
          "@expo/config-plugins": "55.0.10"
        }
      }
    }
  }
}
