{
  "name": "food-tracker-app",
  "version": "1.0.0",
  "description": "Mobile tracker application with React frontend and Go backend",
  "scripts": {
    "dev": "concurrently \"npm run frontend\" \"npm run backend\"",
    "frontend": "cd frontend && npm run dev",
    "backend": "cd backend && go run . serve",
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend && go mod tidy",
    "install:all": "npm run install:frontend && npm run install:backend",
    "test:e2e": "start-server-and-test dev 'http://localhost:8090|http://localhost:1420' 'cd frontend && npm run cypress:run'",
    "mobile:install": "npm --prefix apps/mobile install",
    "mobile:start": "npm --prefix apps/mobile run start --port=19000",
    "mobile:ios": "npm --prefix apps/mobile run ios",
    "mobile:android": "npm --prefix apps/mobile run android",
    "mobile:update:preview": "npm --prefix apps/mobile run update:preview",
    "mobile:lint": "npm --prefix apps/mobile run lint",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
    "mobile:test": "npm --prefix apps/mobile run test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "start-server-and-test": "^2.1.2"
  },
  "dependencies": {}
}
