# Frontend Environment Variables

# API Configuration
# Note: PocketBase automatically appends /api/ to all requests, so don't include it here!
# For local development, use localhost (default if not set)
VITE_API_URL=http://127.0.0.1:8090

# For production deployments, this will be automatically set by the deploy script:
# Beta: VITE_API_URL=https://beta.trackyourfoods.com
# Production: VITE_API_URL=https://trackyourfoods.com

# Environment Mode (automatically managed by Vite - DO NOT SET MANUALLY)
# - Development: import.meta.env.DEV = true (npm run dev)
# - Production: import.meta.env.DEV = false (npm run build)
# This controls the custom logger (src/lib/logger.ts):
#   - Dev mode: All logger.log/warn/error statements output to console
#   - Prod mode: All logger statements are silent (no console output)

# NOTE: Google Places API and Gemini API keys are now stored in the backend
# See backend/.env.example for API key configuration

# Analytics Configuration (PostHog)
# Get your API key from https://posthog.com (free tier available)
# Analytics requests are proxied through the backend at /api/visit-insights
# This path is disguised as "visit insights" to blend with the app and bypass ad blockers
VITE_POSTHOG_KEY=phc_your_project_api_key_here
# Set to 'true' to disable analytics in development
VITE_DISABLE_ANALYTICS=false
