# Frontend Environment Variables

# API Configuration
# Note: PocketBase automatically appends /api/ to all requests, so don't include it here!
# For local development, use localhost (default if not set)
VITE_API_URL=http://127.0.0.1:8090

# For production deployments, this will be automatically set by the deploy script:
# Beta: VITE_API_URL=https://beta.myexperiment.life
# Production: VITE_API_URL=https://myexperiment.life

# Google Places API
# Get your API key from: https://console.cloud.google.com/google/maps-apis/credentials
# Enable the Places API (New) in your Google Cloud project
VITE_GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
