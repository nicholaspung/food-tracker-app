# Backend Environment Variables

# Google Gemini API Key
# Get your API key from: https://makersuite.google.com/app/apikey
# Used for menu OCR/parsing via the /api/parse-menu endpoint
GEMINI_API_KEY=your_gemini_api_key_here

# Google Places API Key
# Get your API key from: https://console.cloud.google.com/google/maps-apis/credentials
# Enable the Places API and Geocoding API in your Google Cloud project
# Used for restaurant search via /api/places/* endpoints
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Google Cloud Vision API Key
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable the Cloud Vision API in your Google Cloud project
# Used for OCR text detection via /api/ocr endpoint
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here
