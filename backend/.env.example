# Backend Environment Variables

# Google Gemini API Key
# Get your API key from: https://makersuite.google.com/app/apikey
# Used for menu OCR/parsing via the /api/parse-menu endpoint
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud API Key (Places & Vision API)
# Get your API key from: https://console.cloud.google.com/google/maps-apis/credentials
# Enable these APIs in your Google Cloud project:
#   - Places API (for restaurant search)
#   - Geocoding API (for location search)
#   - Cloud Vision API (for OCR text detection)
# Used for:
#   - Restaurant search via /api/places/* endpoints
#   - OCR text detection via /api/ocr endpoint
GOOGLE_PLACES_API_KEY=your_google_cloud_api_key_here

# PostHog Analytics (Optional)
# Get your API key from: https://posthog.com
# Used for LLM observability and backend analytics
# The backend also acts as a reverse proxy for frontend analytics at /api/visit-insights
# This path is disguised to blend with the app and bypass ad blockers
# If not set, analytics will be disabled (no impact on functionality)
POSTHOG_API_KEY=phc_your_posthog_api_key_here
POSTHOG_HOST=https://us.i.posthog.com

# Stripe billing configuration
# Create recurring Stripe prices for the monthly and yearly plans.
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRICE_MONTHLY=price_your_monthly_price_id_here
STRIPE_PRICE_YEARLY=price_your_yearly_price_id_here
