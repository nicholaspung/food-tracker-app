# Runtime environment mode. Supported values: local, beta, production.
FOOD_TRACKER_ENV=local

# Optional runtime URL overrides. Leave aligned with FOOD_TRACKER_ENV unless you need a custom host.
FOOD_TRACKER_MARKETING_URL=http://localhost:4173
FOOD_TRACKER_APP_URL=http://localhost:8081
FOOD_TRACKER_ADMIN_URL=http://localhost:5173
FOOD_TRACKER_API_BASE_URL=http://127.0.0.1:8090
FOOD_TRACKER_POCKETBASE_URL=http://127.0.0.1:8090
FOOD_TRACKER_POSTHOG_HOST=http://127.0.0.1:8090/api/analytics
FOOD_TRACKER_APP_SCHEME=yummyrecs

# Required backend integrations
GEMINI_API_KEY=
GOOGLE_PLACES_API_KEY=

# Optional backend analytics
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Optional Expo push security token. Required before enabling push security in the EAS dashboard.
# Leave blank for local development and existing deployments that have not enabled Expo push security.
EXPO_PUSH_ACCESS_TOKEN=
