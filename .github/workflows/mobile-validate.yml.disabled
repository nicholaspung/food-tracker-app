name: Mobile Validate

on:
  pull_request:
    paths:
      - "apps/mobile/**"
      - "package.json"
      - "pnpm-lock.yaml"
      - "pnpm-workspace.yaml"
      - "scripts/mobile-doctor.sh"
      - "scripts/verify-mobile-native-sync.mjs"
      - ".github/workflows/mobile-validate.yml"
      - ".github/workflows/mobile-preview.yml"
  workflow_dispatch:

concurrency:
  group: mobile-validate-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  validate:
    name: Validate Mobile SDK 55
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5

      - name: Set up Node.js
        uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38 # v6
        with:
          node-version: 22
          package-manager-cache: false

      - name: Enable Corepack
        run: corepack enable

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Lint mobile app
        run: pnpm mobile:lint

      - name: Typecheck mobile app
        run: pnpm mobile:typecheck

      - name: Test mobile app
        run: pnpm mobile:test

      - name: Check mobile unused exports
        run: pnpm mobile:unused-exports

      - name: Run Expo Doctor
        run: pnpm mobile:doctor

      - name: Audit dependencies
        run: pnpm audit --json
