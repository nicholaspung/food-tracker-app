{
  "expo": {
    "name": "Yummy Recs",
    "slug": "food-tracker-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "yummyrecs",
    "userInterfaceStyle": "light",
    "jsEngine": "hermes",
    "icon": "./assets/brand-logo.png",
    "ios": {
      "bundleIdentifier": "com.anonymous.yummy-recs-mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Yummy Recs to scan friend QR codes.",
        "NSLocationWhenInUseUsageDescription": "Allow Yummy Recs to use your GPS location for notes.",
        "NSPhotoLibraryUsageDescription": "Allow Yummy Recs to select menu photos from your library.",
        "NSPhotoLibraryAddUsageDescription": "Allow Yummy Recs to save processed menu photos when needed.",
        "CFBundleDisplayName": "Yummy Recs",
        "CFBundleName": "Yummy Recs"
      },
      "runtimeVersion": "1.0.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand-logo.png",
        "backgroundColor": "#F4EFEA"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Yummy Recs to scan friend QR codes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Yummy Recs to use your GPS location for notes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Yummy Recs to select menu photos from your library.",
          "cameraPermission": "Allow Yummy Recs to capture menu photos."
        }
      ],
      "expo-iap",
      "expo-localization",
      "posthog-react-native/expo",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "437930fd-d813-492b-bd18-c545de345b95"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/437930fd-d813-492b-bd18-c545de345b95"
    }
  }
}
