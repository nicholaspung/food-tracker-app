{
  "expo": {
    "name": "Food Tracker Mobile",
    "slug": "food-tracker-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "foodtracker",
    "userInterfaceStyle": "light",
    "jsEngine": "hermes",
    "ios": {
      "bundleIdentifier": "com.anonymous.food-tracker-mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Food Tracker Mobile to scan friend QR codes."
      }
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Food Tracker Mobile to scan friend QR codes."
        }
      ]
    ]
  }
}
