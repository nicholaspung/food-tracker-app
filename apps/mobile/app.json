{
  "expo": {
    "name": "Yummy Recs",
    "slug": "food-tracker-mobile",
    "version": "1.0.2",
    "orientation": "portrait",
    "scheme": "yummyrecs",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/brand-logo.png",
    "web": {
      "favicon": "./assets/brand-logo.png",
      "name": "Yummy Recs",
      "shortName": "Yummy Recs"
    },
    "ios": {
      "bundleIdentifier": "com.yummyrecs.mobile",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Yummy Recs to scan QR codes and capture food photos.",
        "NSLocationWhenInUseUsageDescription": "Allow Yummy Recs to use your GPS location to find nearby restaurants during search.",
        "NSPhotoLibraryUsageDescription": "Allow Yummy Recs to select food photos from your library.",
        "CFBundleDisplayName": "Yummy Recs",
        "CFBundleName": "Yummy Recs",
        "ITSAppUsesNonExemptEncryption": false
      },
      "runtimeVersion": "1.0.2"
    },
    "android": {
      "package": "com.yummyrecs.mobile",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand-logo.png",
        "backgroundColor": "#F4EFEA"
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Yummy Recs to scan QR codes and capture food photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationWhenInUsePermission": "Allow Yummy Recs to use your GPS location to find nearby restaurants during search."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Yummy Recs to select food photos from your library.",
          "cameraPermission": "Allow Yummy Recs to scan QR codes and capture food photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/brand-logo.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "expo-notifications",
      "posthog-react-native/expo",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "437930fd-d813-492b-bd18-c545de345b95"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/437930fd-d813-492b-bd18-c545de345b95"
    }
  }
}
