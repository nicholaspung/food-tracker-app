{
  "name": "@food-tracker/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.1.2",
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    },
    "install": {
      "exclude": [
        "expo",
        "expo-camera",
        "expo-updates",
        "react-native-reanimated",
        "react-native-worklets"
      ]
    }
  },
  "main": "./index.js",
  "scripts": {
    "dev": "bash ../../scripts/mobile-expo.sh local",
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web:build": "expo export --platform web --output-dir web-dist",
    "update:preview": "APP_VARIANT=preview eas update --channel preview --environment preview",
    "update:production-preview": "APP_VARIANT=preview eas update --channel production-preview --environment production",
    "update:production": "APP_VARIANT=production eas update --channel production --environment production",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.11",
    "@tanstack/query-async-storage-persister": "^5.99.0",
    "@tanstack/query-persist-client-core": "^5.99.0",
    "@tanstack/react-query": "^5.99.0",
    "expo": "55.0.25",
    "expo-application": "~55.0.15",
    "expo-camera": "55.0.18",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.35",
    "expo-device": "~55.0.17",
    "expo-file-system": "~55.0.22",
    "expo-font": "~55.0.8",
    "expo-image-manipulator": "~55.0.17",
    "expo-image-picker": "~55.0.20",
    "expo-localization": "~55.0.15",
    "expo-location": "~55.1.10",
    "expo-media-library": "~55.0.17",
    "expo-notifications": "~55.0.23",
    "expo-secure-store": "~55.0.14",
    "expo-splash-screen": "~55.0.21",
    "expo-sqlite": "~55.0.16",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.18",
    "expo-updates": "55.0.23",
    "expo-video": "~55.0.17",
    "pocketbase": "^0.26.8",
    "posthog-react-native": "4.45.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-maps": "1.27.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.3.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@eslint/eslintrc": "^2.1.4",
    "@posthog/cli": "^0.7.11",
    "@react-navigation/routers": "7.5.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~55.0.8",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~55.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.18",
    "knip": "6.3.1",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.7.2"
  }
}
