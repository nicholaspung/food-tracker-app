{
  "name": "@food-tracker/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.5.3",
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "main": "./index.js",
  "scripts": {
    "dev": "bash ../../scripts/mobile-expo.sh local",
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web:build": "expo export --platform web --output-dir web-dist",
    "update:preview": "APP_VARIANT=preview eas update --channel preview --environment preview",
    "update:production-preview": "APP_VARIANT=preview eas update --channel production-preview --environment production",
    "update:production": "APP_VARIANT=production eas update --channel production --environment production",
    "version:bump:patch": "node ../../scripts/bump-mobile-expo-version.mjs patch",
    "build:ios:production": "pnpm run version:bump:patch && APP_VARIANT=production eas build --platform ios --profile production",
    "build:ios:production:submit": "pnpm run version:bump:patch && APP_VARIANT=production eas build --platform ios --profile production --auto-submit",
    "build:ios:production:submit:no-bump": "APP_VARIANT=production eas build --platform ios --profile production --auto-submit",
    "submit:ios:production": "APP_VARIANT=production eas submit --platform ios --profile production --latest",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@expo/dom-webview": "~57.0.1",
    "@expo/ui": "~57.0.14",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-vector-icons/ionicons": "^13.1.2",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.11",
    "@tanstack/query-async-storage-persister": "^5.99.0",
    "@tanstack/query-persist-client-core": "^5.99.0",
    "@tanstack/react-query": "^5.99.0",
    "expo": "~57.0.17",
    "expo-application": "~57.0.2",
    "expo-camera": "57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.15",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-image-manipulator": "~57.0.14",
    "expo-image-picker": "~57.0.14",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.14",
    "expo-media-library": "~57.0.4",
    "expo-notifications": "~57.0.15",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.18",
    "expo-video": "~57.0.3",
    "pocketbase": "^0.26.8",
    "posthog-react-native": "4.46.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-maps": "1.27.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/eslintrc": "^2.1.4",
    "@posthog/cli": "^0.8.4",
    "@react-navigation/routers": "7.5.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "babel-preset-expo": "~57.0.7",
    "eas-cli": "19.0.8",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "knip": "6.3.1",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  }
}
