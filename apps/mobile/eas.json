{
  "cli": {
    "version": ">= 18.0.3",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "local"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "beta",
        "EXPO_PUBLIC_WEB_DISABLE_VISIT_MUTATIONS": "true",
        "EXPO_PUBLIC_WEB_DISABLE_QUICKTRACK_MUTATIONS": "true",
        "EXPO_PUBLIC_BETA_ADMIN_ONLY": "true"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_WEB_DISABLE_VISIT_MUTATIONS": "true",
        "EXPO_PUBLIC_WEB_DISABLE_QUICKTRACK_MUTATIONS": "true",
        "EXPO_PUBLIC_BETA_ADMIN_ONLY": "false"
      },
      "channel": "production"
    },
    "ios-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "local"
      },
      "channel": "ios-simulator"
    }
  },
  "submit": {
    "production": {}
  }
}
