{
  "cli": {
    "version": ">= 18.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.14.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "image": "latest"
      },
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_APP_ENV": "local"
      },
      "channel": "development"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview",
      "ios": {
        "image": "latest",
        "buildConfiguration": "ReleasePreview"
      },
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_APP_ENV": "beta",
        "EXPO_PUBLIC_WEB_DISABLE_VISIT_MUTATIONS": "true",
        "EXPO_PUBLIC_WEB_DISABLE_QUICKTRACK_MUTATIONS": "true",
        "EXPO_PUBLIC_BETA_ADMIN_ONLY": "true"
      },
      "channel": "preview"
    },
    "production-preview": {
      "extends": "base",
      "distribution": "internal",
      "environment": "production",
      "ios": {
        "image": "latest",
        "buildConfiguration": "ReleasePreview"
      },
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_WEB_DISABLE_VISIT_MUTATIONS": "true",
        "EXPO_PUBLIC_WEB_DISABLE_QUICKTRACK_MUTATIONS": "true",
        "EXPO_PUBLIC_BETA_ADMIN_ONLY": "false"
      },
      "channel": "production-preview"
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "environment": "production",
      "ios": {
        "image": "latest"
      },
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_WEB_DISABLE_VISIT_MUTATIONS": "true",
        "EXPO_PUBLIC_WEB_DISABLE_QUICKTRACK_MUTATIONS": "true",
        "EXPO_PUBLIC_BETA_ADMIN_ONLY": "false"
      },
      "channel": "production"
    },
    "ios-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      },
      "environment": "development",
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_APP_ENV": "local"
      },
      "channel": "ios-simulator"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6761597807"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    }
  }
}
