# Environment mode. Supported values: local, beta, production.
EXPO_PUBLIC_APP_ENV=local
# Local `pnpm dev` / `pnpm mobile:*` commands ignore this file and inject local-safe values.
# Direct Expo commands run inside `apps/mobile` will still read it unless you set `EXPO_NO_DOTENV=1`.

# Backend base URL used for API calls
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8090
# Beta build example: EXPO_PUBLIC_API_BASE_URL=https://beta.app.yummyrecs.com
# Production build example: EXPO_PUBLIC_API_BASE_URL=https://app.yummyrecs.com

# PocketBase base URL (defaults to EXPO_PUBLIC_API_BASE_URL when omitted)
EXPO_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# Optional explicit web/admin/marketing URLs. Usually inferred from EXPO_PUBLIC_APP_ENV.
EXPO_PUBLIC_APP_WEB_URL=http://localhost:8081
EXPO_PUBLIC_ADMIN_URL=http://localhost:5173
EXPO_PUBLIC_MARKETING_URL=http://localhost:4173

# Optional observability configuration
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
