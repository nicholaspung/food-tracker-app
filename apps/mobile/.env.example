# Backend base URL used for API calls
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8090
# Beta build example: EXPO_PUBLIC_API_BASE_URL=https://beta.yummyrecs.com
# Production build example: EXPO_PUBLIC_API_BASE_URL=https://yummyrecs.com

# PocketBase base URL (defaults to EXPO_PUBLIC_API_BASE_URL when omitted)
EXPO_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# Optional observability configuration
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# In-app subscription product IDs (App Store / Play Store)
EXPO_PUBLIC_IAP_MONTHLY_PRODUCT_ID=yummyrecs.subscription.monthly
EXPO_PUBLIC_IAP_YEARLY_PRODUCT_ID=yummyrecs.subscription.yearly

# Android application package name (used for native manage-subscription deep links)
EXPO_PUBLIC_ANDROID_PACKAGE_NAME=com.anonymous.yummy-recs-mobile
