# Environment mode. Supported values: local, beta, production.
VITE_APP_ENV=local

# Backend/API origin. For beta and production this is normally the admin site origin.
VITE_API_URL=http://127.0.0.1:8090

# Optional explicit admin origin override. Usually inferred from VITE_APP_ENV.
VITE_ADMIN_URL=http://localhost:5173
